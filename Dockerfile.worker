FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Arsenal completo: compiladores y librerías de imagen
RUN apt-get update && apt-get install -y \
    libpq-dev gcc cmake g++ git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir setuptools==70.0.0

# Instalamos AMBOS: base + pesados
COPY requirements.txt requirements-worker.txt /app/
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-worker.txt

COPY . /app/